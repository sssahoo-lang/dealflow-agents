DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5433/crm

# Tokens are signed with RS256 and verified from /.well-known/jwks.json, so the
# CRM is the only service that holds signing material. Leave JWT_PRIVATE_KEY
# empty for local development and an ephemeral keypair is generated at startup;
# set it (a PKCS#8 PEM, one line with \n escapes or a mounted file's contents)
# for anything that must survive a restart or run more than one replica.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
JWT_PRIVATE_KEY=
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# stub = deterministic, no API key, no network (default -- the app runs as-is).
# anthropic = real Claude calls; requires ANTHROPIC_API_KEY below.
LLM_PROVIDER=stub

ANTHROPIC_API_KEY=
LEAD_SCORING_MODEL=claude-sonnet-5
FOLLOW_UP_MODEL=claude-sonnet-5
NL_QUERY_MODEL=claude-sonnet-5
