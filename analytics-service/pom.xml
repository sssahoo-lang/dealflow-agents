<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.1</version>
    <relativePath/>
  </parent>

  <groupId>com.dealflow</groupId>
  <artifactId>analytics-service</artifactId>
  <version>0.1.0</version>
  <name>analytics-service</name>
  <description>Pipeline analytics and rules engine, fed by the CRM outbox</description>

  <properties>
    <java.version>21</java.version>
    <jjwt.version>0.12.6</jjwt.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- JDBC, not JPA. Every write in this service is a guarded upsert
         (ON CONFLICT DO UPDATE guarded on last_event_id) and every
         read is an aggregate computed at query time. There are no entity graphs
         to navigate, so Hibernate would be mapped over SQL we would write by hand
         anyway. Tradeoff accepted: we lose the ddl-auto:validate startup drift
         check, so the integration tests run every statement against the real
         Flyway-built schema instead. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- /actuator/health backs the compose healthcheck. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Flyway owns the analytics schema. Same mental model as Alembic on the
         Python side: plain versioned SQL, reviewable in a diff. As of Flyway 10
         the Postgres support is a separate artifact. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Deliberately NOT spring-boot-starter-security: this service only needs to
         verify an RS256 signature against a fetched JWKS. A ~120-line filter beats
         pulling in the whole filter chain, the default user generator, and CSRF
         config that would immediately be disabled again. -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Distributed tracing, opt-in (otel.sdk.disabled defaults to true; see
         application.yml). The Spring Boot starter auto-configures an SDK
         TracerProvider from those properties rather than requiring a javaagent,
         which keeps the deployment a plain `java -jar`. Manual spans in
         OutboxDispatcher are what actually connect a consumed event back to the
         CRM request that produced it; this dependency is what gives those spans
         somewhere real to go. -->
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-spring-boot-starter</artifactId>
    </dependency>
    <!-- InMemorySpanExporter and a throwaway SDK; lets OutboxTracingTest assert
         real parent/child linkage rather than mocking the tracer and trusting
         that the mock's contract matches the real one. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <!-- opentelemetry-instrumentation-bom imports opentelemetry-bom transitively,
           which is what pins opentelemetry-sdk-testing's version alongside the
           API/SDK versions the starter itself uses; one version list, not two
           that could drift apart. -->
      <dependency>
        <groupId>io.opentelemetry.instrumentation</groupId>
        <artifactId>opentelemetry-instrumentation-bom</artifactId>
        <version>2.11.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Deliberate split. `mvn test` runs *Test only: pure unit tests, no
           database, fast enough for every edit. `mvn verify` adds *IT, which
           need a live Postgres. Keeping them separate means a failing DB
           connection can never be mistaken for a logic regression. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
